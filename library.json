{
  "name": "PixelBixn Floppy Disk Audio Simulator",
  "version": "1.0.0",
  "description": "ESP32-C3 based audio simulator that recreates authentic floppy disk drive sounds with web interface and NFC triggering",
  "keywords": [
    "esp32",
    "esp32-c3",
    "audio",
    "floppy-disk",
    "retro",
    "simulator",
    "nfc",
    "web-interface",
    "platformio",
    "arduino"
  ],
  "homepage": "https://github.com/yourusername/floppy-disk-audio-simulator",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/floppy-disk-audio-simulator.git"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Your Name",
      "email": "your.email@example.com",
      "maintainer": true
    }
  ],
  "platforms": [
    "espressif32"
  ],
  "frameworks": [
    "arduino"
  ],
  "dependencies": [
    {
      "name": "me-no-dev/ESPAsyncWebServer",
      "version": "^1.2.3"
    },
    {
      "name": "me-no-dev/AsyncTCP", 
      "version": "^1.1.1"
    },
    {
      "name": "bblanchon/ArduinoJson",
      "version": "^6.21.3"
    },
    {
      "name": "adafruit/Adafruit SSD1306",
      "version": "^2.5.7"
    },
    {
      "name": "adafruit/Adafruit GFX Library",
      "version": "^1.11.5"
    },
    {
      "name": "earlephilhower/ESP8266Audio",
      "version": "^1.9.7"
    },
    {
      "name": "miguelbalboa/MFRC522",
      "version": "^1.4.10"
    },
    {
      "name": "lorol/LittleFS_esp32",
      "version": "^1.0.6"
    }
  ],
  "export": {
    "include": [
      "include/*",
      "src/*",
      "data/*",
      "docs/*",
      "examples/*",
      "README.md",
      "LICENSE",
      "platformio.ini"
    ],
    "exclude": [
      ".git*",
      ".vscode",
      "test",
      "*.tmp",
      "*.log"
    ]
  }
}